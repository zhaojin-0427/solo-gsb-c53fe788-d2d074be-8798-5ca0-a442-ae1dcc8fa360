# 复制为 .env 并按需修改；生产环境务必更换全部密钥
KEYVAULT_DATABASE_URL=postgresql://keyvault:keyvault@db:5432/keyvault
# 32 字节字符串或 64 位 hex
KEYVAULT_SHARD_MASTER_KEY=dev-only-shard-master-key-32bytes
KEYVAULT_ADMIN_API_KEY=admin-dev-key
# 恢复会话默认/上限 TTL（秒）
KEYVAULT_RECOVERY_DEFAULT_TTL=300
KEYVAULT_RECOVERY_MAX_TTL=600
# 限时恢复冻结的最短/最长时长（秒）；请求的 valid_until 必须落在该窗口内
KEYVAULT_FREEZE_MIN_SECONDS=10
KEYVAULT_FREEZE_MAX_SECONDS=7776000
# 仅本地并发竞态回归使用：开启故障注入闸门。生产/普通部署务必保持关闭（关闭时零开销）。
KEYVAULT_FAULT_INJECTION=0
